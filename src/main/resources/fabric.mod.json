{
  "schemaVersion": 1,
  "id": "coread",
  "version": "${version}",
  "name": "Core Adventures",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/coread/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.adex.CoreAdventures"
    ],
    "client": [
      "com.adex.CoreAdventuresClient"
    ],
    "fabric-datagen": [
      "com.adex.datagen.ModDataGenerator"
    ]
  },
  "mixins": [
    "coread.mixins.json",
    {
      "config": "coread.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.6",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}